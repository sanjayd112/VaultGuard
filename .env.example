# Copy to .env  (or run:  python init_env.py)   NEVER commit the real .env file.
VAULTGUARD_ENV=development
# 32-byte (256-bit) AES key, base64 encoded.  Generate with: python init_env.py
ENCRYPTION_KEY=
# Flask session signing key.
SECRET_KEY=
# Optional tuning
MAX_UPLOAD_MB=16
SESSION_MINUTES=30
RESTRICTION_MINUTES=15
